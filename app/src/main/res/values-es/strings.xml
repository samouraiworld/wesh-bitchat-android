    <string name="location_explanation">Wesh NO rastrea tu ubicación.\n\nLos servicios de ubicación son requeridos para el escaneo Bluetooth y la función de chat geohash.</string>
    <string name="location_needs_for">Wesh necesita servicios de ubicación para:</string>
    <string name="location_needs_bullets">• Escaneo de dispositivos Bluetooth\n• Descubrir usuarios cercanos en la red mesh\n• Función de chat geohash\n• Sin rastreo o recolección de ubicación</string>
    <string name="open_location_settings">Abrir configuraciones de ubicación</string>
    <string name="check_again">Verificar de nuevo</string>
    <string name="location_services_unavailable">Servicios de ubicación no disponibles</string>
    <string name="location_unavailable_explanation">Los servicios de ubicación no están disponibles en este dispositivo. Esto es inusual ya que los servicios de ubicación son estándar en dispositivos Android.\n\nWesh requiere servicios de ubicación para el funcionamiento adecuado del escaneo Bluetooth (requisito de Android). Sin esto, la app no puede descubrir usuarios cercanos.</string>
    <string name="checking_location_services">Verificando servicios de ubicación…</string>
    <string name="bluetooth_required">Bluetooth requerido</string>
    <string name="bluetooth_needs_for">Wesh necesita Bluetooth para:</string>
    <string name="bluetooth_needs_bullets">• Descubrir usuarios cercanos\n• Crear conexiones de red mesh\n• Enviar y recibir mensajes\n• Funcionar sin internet o servidores</string>
    <string name="enable_bluetooth">Habilitar Bluetooth</string>
    <string name="bluetooth_not_supported">Bluetooth no soportado</string>
    <string name="bluetooth_unsupported_explanation">Este dispositivo no soporta Bluetooth Low Energy (BLE), que es requerido para que Wesh funcione.\n\nWesh requiere BLE para crear redes mesh y comunicarse con dispositivos cercanos sin internet.</string>
    <string name="checking_bluetooth_status">Verificando estado de Bluetooth…</string>
