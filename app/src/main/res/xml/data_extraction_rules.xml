<?xml version="1.0" encoding="utf-8"?>
<!-- API 31 and up. Device transfer ignores allowBackup="false", so every domain is excluded:
     identity, keys, conversations, settings and Tor state never leave the phone, from
     credential-protected or device-protected (direct boot) storage. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_sharedpref" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_file" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="external" path="."/>
        <exclude domain="device_root" path="."/>
        <exclude domain="device_sharedpref" path="."/>
        <exclude domain="device_database" path="."/>
        <exclude domain="device_file" path="."/>
    </device-transfer>
</data-extraction-rules>
