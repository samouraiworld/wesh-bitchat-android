    <string name="location_services_required">Yêu cầu dịch vụ vị trí</string>
    <string name="privacy_first">Quyền riêng tư trước tiên</string>
    <string name="location_explanation">Wesh KHÔNG theo dõi vị trí của bạn.\n\nDịch vụ vị trí cần thiết cho quét Bluetooth và tính năng geohash chat.</string>
    <string name="location_needs_for">Wesh cần dịch vụ vị trí cho:</string>
    <string name="location_needs_bullets">• Quét thiết bị Bluetooth\n• Khám phá người dùng gần đó trong mạng mesh\n• Tính năng geohash chat\n• Không theo dõi hoặc thu thập vị trí</string>
    <string name="open_location_settings">Mở cài đặt vị trí</string>
    <string name="check_again">Kiểm tra lại</string>
    <string name="location_services_unavailable">Dịch vụ vị trí không có sẵn</string>
    <string name="location_unavailable_explanation">Dịch vụ vị trí không có sẵn trên thiết bị này. Điều này bất thường vì dịch vụ vị trí là tiêu chuẩn trên thiết bị Android.\n\nWesh cần dịch vụ vị trí để quét Bluetooth hoạt động đúng (yêu cầu Android). Không có nó, ứng dụng không thể khám phá người dùng gần đó.</string>
    <string name="checking_location_services">Đang kiểm tra dịch vụ vị trí …</string>
    <string name="bluetooth_required">Yêu cầu Bluetooth</string>
    <string name="bluetooth_needs_for">Wesh cần Bluetooth cho:</string>
    <string name="bluetooth_needs_bullets">• Khám phá người dùng gần đó\n• Tạo kết nối mạng mesh\n• Gửi và nhận tin nhắn\n• Hoạt động mà không cần Internet hoặc máy chủ</string>
    <string name="enable_bluetooth">Bật Bluetooth</string>
    <string name="bluetooth_not_supported">Bluetooth không được hỗ trợ</string>
    <string name="bluetooth_unsupported_explanation">Thiết bị này không hỗ trợ Bluetooth Low Energy (BLE), cần thiết để Wesh hoạt động.\n\nWesh cần BLE để tạo mạng mesh và liên lạc với thiết bị gần đó mà không cần Internet.</string>
