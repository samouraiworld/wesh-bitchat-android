    <string name="location_services_required">Standortdienste erforderlich</string>
    <string name="privacy_first">Privatsphäre zuerst</string>
    <string name="location_explanation">Wesh verfolgt NICHT deinen Standort.\n\nStandortdienste sind für Bluetooth‑Scanning und das Geohash‑Chat‑Feature erforderlich.</string>
    <string name="location_needs_for">Wesh benötigt Standortdienste für:</string>
    <string name="location_needs_bullets">• Bluetooth‑Gerätescanning\n• Entdecken nahegelegener Benutzer im Mesh‑Netzwerk\n• Geohash‑Chat‑Feature\n• Keine Verfolgung oder Standortsammlung</string>
    <string name="open_location_settings">Standorteinstellungen öffnen</string>
    <string name="check_again">Erneut prüfen</string>
    <string name="location_services_unavailable">Standortdienste nicht verfügbar</string>
    <string name="location_unavailable_explanation">Standortdienste sind auf diesem Gerät nicht verfügbar. Das ist ungewöhnlich, da Standortdienste bei Android‑Geräten Standard sind.\n\nWesh benötigt Standortdienste für das ordnungsgemäße Funktionieren des Bluetooth‑Scannings (Android‑Anforderung). Ohne diese kann die App keine nahegelegenen Benutzer entdecken.</string>
    <string name="checking_location_services">Standortdienste werden geprüft …</string>
    <string name="bluetooth_required">Bluetooth erforderlich</string>
    <string name="bluetooth_needs_for">Wesh benötigt Bluetooth für:</string>
    <string name="bluetooth_needs_bullets">• Entdecken nahegelegener Benutzer\n• Erstellen von Mesh‑Netzwerkverbindungen\n• Senden und Empfangen von Nachrichten\n• Funktionieren ohne Internet oder Server</string>
    <string name="enable_bluetooth">Bluetooth aktivieren</string>
    <string name="bluetooth_not_supported">Bluetooth nicht unterstützt</string>
    <string name="bluetooth_unsupported_explanation">Dieses Gerät unterstützt kein Bluetooth Low Energy (BLE), das für das Funktionieren von Wesh erforderlich ist.\n\nWesh benötigt BLE, um Mesh‑Netzwerke zu erstellen und ohne Internet mit nahegelegenen Geräten zu kommunizieren.</string>
    <string name="checking_bluetooth_status">Bluetooth‑Status wird geprüft …</string>
    <string name="battery_optimization_detected_title">Akku‑Optimierung erkannt</string>
    <string name="battery_optimization_enabled_title">Akku‑Optimierung aktiviert</string>
    <string name="battery_optimization_explanation_short">Wesh muss im Hintergrund laufen, um Mesh‑Verbindungen aufrechtzuerhalten. Die Akku‑Optimierung kann diese Verbindungen unterbrechen.</string>
    <string name="benefits_of_disabling">Vorteile der Deaktivierung</string>
    <string name="battery_benefits_short">• zuverlässige Nachrichtenzustellung\n• Aufrechterhaltung der Mesh‑Konnektivität\n• verhindert Verbindungsabbrüche</string>
